# ==============================================================================
# PrimePrep Environment Configuration
# All values shown below are non-secret placeholders for documentation only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Browser Accessible)
# ------------------------------------------------------------------------------
# Found in your Supabase Dashboard: Project Settings -> API
# VITE_SUPABASE_URL: The HTTPS URL of your Supabase project (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# VITE_SUPABASE_ANON_KEY: The public anon/publishable key safe for client-side browsers.
# Enforces Row Level Security (RLS) on all requests.
VITE_SUPABASE_ANON_KEY="your-public-anon-key-placeholder"

# ------------------------------------------------------------------------------
# 2. Supabase Server-Side Admin Configuration (PRIVATE / SERVER ONLY)
# ------------------------------------------------------------------------------
# WARNING: NEVER prefix this key with VITE_ and NEVER expose it to the browser.
# Found in Supabase Dashboard: Project Settings -> API -> service_role secret
# Used by server.ts for privileged operations (user management, administrative audit)
SUPABASE_SERVICE_ROLE_KEY="your-server-service-role-key-placeholder"

# ------------------------------------------------------------------------------
# 3. Direct PostgreSQL Connection Settings (Optional for CLI migrations)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard: Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 4. Application Server Settings
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
